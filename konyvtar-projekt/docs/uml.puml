@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "com.konyvtar.model" {
    abstract class Dokumentum {
        - cim: String
        - ar: int
        + Dokumentum(cim: String, ar: int)
        + getCim(): String
        + getAr(): int
        {abstract} + getTipusLeiras(): String
    }

    class Konyv {
        - szerzo: String
        + Konyv(cim: String, ar: int, szerzo: String)
        + getSzerzo(): String
        + getTipusLeiras(): String
    }

    class Folyoirat {
        - evfolyam: int
        + Folyoirat(cim: String, ar: int, evfolyam: int)
        + getEvfolyam(): int
        + getTipusLeiras(): String
    }

    class HibasAdatException {
        + HibasAdatException(message: String)
    }
}

package "com.konyvtar.service" {
    class DokumentumFactory {
        + {static} letrehoz(tipus: String, cim: String, ar: int, extra: String): Dokumentum
    }

    class KonyvtarKezelo {
        - dokumentumok: List<Dokumentum>
        + hozzaad(d: Dokumentum): void
        + getDokumentumok(): List<Dokumentum>
        + rendezArSzerint(): void
        + rendezCimSzerint(): void
    }
}

package "com.konyvtar.persistence" {
    class AdatKezelo {
        + {static} mentes(fajlNev: String, lista: List<Dokumentum>): void
        + {static} betoltes(fajlNev: String): List<Dokumentum>
    }
}

package "com.konyvtar.ui" {
    class KonzolUI {
        - kezelo: KonyvtarKezelo
        - scanner: Scanner
        + indit(): void
    }
}

Dokumentum <|-- Konyv
Dokumentum <|-- Folyoirat
KonyvtarKezelo "1" o-- "0..*" Dokumentum : tartalmaz >
DokumentumFactory ..> Konyv : példányosít >
DokumentumFactory ..> Folyoirat : példányosít >
Dokumentum ..> HibasAdatException : dob >
KonzolUI "1" *-- "1" KonyvtarKezelo : használ >
KonzolUI ..> AdatKezelo : meghív >
KonzolUI ..> DokumentumFactory : meghív >
@enduml
